<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lerobot_teleoperator_rosetta</name>
  <version>0.2.0</version>
  <description>LeRobot Teleoperator plugin for Rosetta - bridges ROS2 topics to LeRobot Teleoperator interface.</description>
  <maintainer email="isaac.blankenau@gmail.com">Isaac Blankenau</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>rosetta</depend>
  <depend>rosetta_ros</depend>
  <depend>python3-numpy</depend>
  <!-- lerobot has no rosdep key, so rosdep can neither install it nor report it
       missing: install it with pip (it is in setup.py install_requires). This
       package is not released to the ROS buildfarm (see CONTRIBUTING.md). -->

  <test_depend>ament_index_python</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
