# Goal
string prompt                       # Task description for the episode
float64 max_duration_s              # Max episode duration (0.0 = use contract default)
float64 success_reward_threshold    # Reward threshold for auto-success (0.0 = disabled)
---
# Result
# termination_reason values: HOW the episode ended. The goal's terminal state
# (SUCCEEDED / CANCELED / ABORTED) says whether the episode reached a defined
# end, was taken away by a client, or was stopped by the server; this field says
# which of those, exactly.
string TERMINATION_STOPPED="stopped"
string TERMINATION_TIMEOUT="timeout"
string TERMINATION_REWARD_THRESHOLD="reward_threshold"
string TERMINATION_CANCELLED="cancelled"
string TERMINATION_NODE_DEACTIVATED="node_deactivated"
string TERMINATION_ERROR="error"

# outcome values: WHETHER THE ROBOT DID THE TASK. Independent of how the episode
# ended -- a timed-out episode can still be a success, and a cleanly stopped one
# can still be a failure. "unlabeled" means nobody claimed either way; it is a
# distinct answer from a classifier honestly reporting a reward of 0.0.
string OUTCOME_SUCCESS="success"
string OUTCOME_FAILURE="failure"
string OUTCOME_UNLABELED="unlabeled"

string termination_reason           # Why the episode ended
string outcome                      # Task verdict
string message                      # Detail when something went wrong; empty otherwise
string bag_path                     # Path to the recorded rosbag
float64 final_reward                # Last reward value at episode end
int32 messages_written              # Total messages recorded
---
# Feedback
float64 elapsed_s                   # Seconds since episode start
float64 current_reward              # Latest reward value
string control_source               # "policy" | "teleop"
string outcome                      # Task verdict so far (Result's OUTCOME_* values)
int32 messages_written              # Messages recorded so far
